{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "rappels/**", "firestore.rules", "README.md"],
    "headers": [
      { "source": "**/*.@(html|js|css|webmanifest|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
